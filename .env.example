# ApexTrainer / SparkyFitness image environment
# Keep SPARKY_FITNESS_* names because the Docker images still expect these variable names.

SPARKY_FITNESS_DB_NAME=apextrainer
SPARKY_FITNESS_DB_USER=sparky
SPARKY_FITNESS_DB_PASSWORD=change_me

SPARKY_FITNESS_APP_DB_USER=sparkyapp
SPARKY_FITNESS_APP_DB_PASSWORD=change_me

SPARKY_FITNESS_API_ENCRYPTION_KEY=change_me_32_chars_min
BETTER_AUTH_SECRET=change_me_strong_secret

SPARKY_FITNESS_FRONTEND_URL=https://apextrainer.duckdns.org
SPARKY_FITNESS_DISABLE_SIGNUP=false

ALLOW_PRIVATE_NETWORK_CORS=false
SPARKY_FITNESS_EXTRA_TRUSTED_ORIGINS=

SPARKY_FITNESS_ADMIN_EMAIL=
SPARKY_FITNESS_EMAIL_HOST=
SPARKY_FITNESS_EMAIL_PORT=
SPARKY_FITNESS_EMAIL_SECURE=
SPARKY_FITNESS_EMAIL_USER=
SPARKY_FITNESS_EMAIL_PASS=
SPARKY_FITNESS_EMAIL_FROM=

DB_PATH=./postgresql
SERVER_BACKUP_PATH=./backup
SERVER_UPLOADS_PATH=./uploads

MCP_GATEWAY_JWT_SECRET=
MCP_GATEWAY_JWT_TTL_SECONDS=300
